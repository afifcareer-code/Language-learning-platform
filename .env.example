# Copy to .env (or enter the same variables in your hosting panel).
# Everything is optional for local development: with no database settings
# the app uses a local SQLite file at ./.data/app.db.

# ── Database ─────────────────────────────────────────────────────────────
# The app detects the database automatically. Use ONE of the options below.
#
# Option A: separate settings, as shown by cPanel / Plesk / aaPanel when you
# create a database (MySQL/MariaDB is assumed unless DB_CONNECTION says otherwise).
# DB_CONNECTION=mysql            # mysql | mariadb | pgsql | postgres | sqlite
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=cpaneluser_llp
# DB_USERNAME=cpaneluser_app
# DB_PASSWORD=
#
# Option B: a single connection URL (Coolify, Railway, Render, Docker, …).
# Special characters in the password must be URL-encoded (@ → %40, : → %3A, / → %2F).
# DATABASE_URL=mysql://user:password@localhost:3306/llp
# DATABASE_URL=postgres://user:password@localhost:5432/llp
# DATABASE_URL=file:./.data/app.db
#
# Also detected automatically: MYSQL_URL, MYSQLHOST/MYSQLUSER/… (Railway),
# POSTGRES_URL (Vercel), PGHOST/PGUSER/… (PostgreSQL defaults).

# Only for remote libSQL / Turso databases.
DATABASE_AUTH_TOKEN=

# ── Startup ──────────────────────────────────────────────────────────────
# Apply database migrations and load bundled content when the server starts.
AUTO_MIGRATE=true
AUTO_SEED=true

# ── App ──────────────────────────────────────────────────────────────────
# Interface language when the learner has not chosen one and the browser's
# language is not supported: en | id. (This is not the language being learned.)
DEFAULT_LOCALE=en

# Display name of the default local learner.
DEFAULT_LEARNER_NAME=Learner

# Authentication. "single" (default): one local learner, no sign-in.
# "accounts": email + password accounts, one learner per account. The first account
# takes over the existing local learner, so current progress is kept. Set this on a
# public deployment so visitors do not share one learner. Serve over HTTPS.
AUTH_MODE=single
