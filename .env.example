# Copy to .env and adjust as needed. All variables are optional for local development.

# libSQL / SQLite connection string.
# Local file (default):        file:./.data/app.db
# Remote libSQL (e.g. Turso):  libsql://<your-db>.turso.io
DATABASE_URL=file:./.data/app.db

# Only required for remote libSQL databases.
DATABASE_AUTH_TOKEN=

# Display name of the default local learner created by `npm run db:seed`.
DEFAULT_LEARNER_NAME=Learner
