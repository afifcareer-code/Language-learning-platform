{
  "name": "language-learning-platform",
  "version": "0.1.0",
  "private": true,
  "description": "An open-source adaptive language learning platform focused on mastery, active recall, progressive practice, and personalized learning.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:server": "node server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "npm run db:generate:sqlite && npm run db:generate:mysql && npm run db:generate:postgres",
    "db:generate:sqlite": "drizzle-kit generate --dialect turso --schema ./src/server/db/schema/sqlite.ts --out ./database/migrations/sqlite",
    "db:generate:mysql": "drizzle-kit generate --dialect mysql --schema ./src/server/db/schema/mysql.ts --out ./database/migrations/mysql",
    "db:generate:postgres": "drizzle-kit generate --dialect postgresql --schema ./src/server/db/schema/postgres.ts --out ./database/migrations/postgres",
    "db:migrate": "tsx scripts/development/migrate.ts",
    "db:seed": "tsx database/seeders/index.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:check": "tsx scripts/development/check-database.ts",
    "db:studio": "drizzle-kit studio",
    "content:validate": "tsx scripts/content/validate.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@next/env": "^16.4.2",
    "drizzle-orm": "^0.45.4",
    "mysql2": "^3.24.6",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
